# Which provider to use: "gemini" or "openrouter"
AI_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- OpenRouter (for testing other models) ---
OPENROUTER_API_KEY=your_openrouter_key_here
# Any vision-capable model from https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o
